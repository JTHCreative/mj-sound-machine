rules_version = '2';

// Replace YOUR_UID_HERE with the UID from firebase-config.js (ownerUid).
// Audio is stored inline as a base64 data URL in the `dataUrl` field.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pads/{padId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "YOUR_UID_HERE";
    }
  }
}
