rules_version = '2';

// Replace YOUR_UID_HERE with the UID from firebase-config.js (ownerUid).
service cloud.firestore {
  match /databases/{database}/documents {
    match /soundboard/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "YOUR_UID_HERE";
    }
  }
}
