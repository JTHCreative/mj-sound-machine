rules_version = '2';

// Audio is stored inline as a base64 data URL in the `dataUrl` field.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pads/{padId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "UYBIT9WXAORu2udX5hpcHMgUii32";
    }
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "UYBIT9WXAORu2udX5hpcHMgUii32";
    }
  }
}
